TELEGRAM_API_KEY=

# Web search: tavily (default) or gemini.
SEARCH_PROVIDER=
TAVILY_API_KEY=

# Only needed when SEARCH_PROVIDER=gemini.
GEMINI_API_KEY=
WEB_SEARCH_MODEL_ID=gemini-2.5-flash-lite

# Image generation: cloudflare, or blank for none.
IMAGE_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
# An API token from the "Workers AI" template.
CLOUDFLARE_API_TOKEN=
# Any FLUX.2 model. Defaults to @cf/black-forest-labs/flux-2-klein-4b.
CLOUDFLARE_IMAGE_MODEL_ID=
# A chat the bot can post in, used to upload images for guest-mode replies.
# Leave blank to make guest-mode replies text only.
TELEGRAM_UPLOAD_CHAT_ID=

# Chat model: Groq, or any OpenAI-compatible API once its base URL is set.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL_ID=qwen/qwen3.8-27b

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_ID=

# Context size in tokens at which the conversation is summarized.
# Leave blank to disable auto-compaction.
AUTO_COMPACT_TOKEN_THRESHOLD=

# Milliseconds before a chat model call is abandoned, e.g. 300000.
# Leave blank for no timeout.
MODEL_TIMEOUT_MS=

# Set to true to log each model request and step, for debugging.
DEBUG_LOGGING=

# Directory for persisted chat history files.
# Defaults to ./data/chats
CHAT_DATA_DIR=
